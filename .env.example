# L'Mere Studio - Environment Variables
# Copy this file to .env and adjust values as needed.

# Canonical PostgreSQL connection used by Prisma tooling and application runtime.
# Local example (PostgreSQL running on localhost):
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@127.0.0.1:5432/lmere?sslmode=disable"

# Destructive synthetic demo seeding is disabled by default.
# Set this to true only for a disposable/local database immediately before `npm run db:seed`.
LMERE_ALLOW_DEMO_SEED="false"
# Optional demo-only password override. The seed never logs this value.
# LMERE_DEMO_ADMIN_PASSWORD="choose-a-local-demo-password"

# Required for signed admin sessions. Use a unique random value of at least 32 bytes.
ADMIN_SESSION_SECRET="replace-with-a-unique-random-value-at-least-32-bytes"

# Optional dedicated HMAC secret for privacy-preserving rate-limit source fingerprints.
# If omitted, ADMIN_SESSION_SECRET is reused with domain separation.
RATE_LIMIT_SECRET="replace-with-another-unique-random-value-at-least-32-bytes"

# Vercel supplies a deployment-controlled client address automatically.
# For another trusted reverse proxy, opt in only if that proxy overwrites X-Forwarded-For.
# RATE_LIMIT_TRUST_X_FORWARDED_FOR="true"
