# L'Mere Studio - Environment Variables
# Copy this file to .env and adjust values as needed.

# Canonical PostgreSQL connection used by Prisma tooling and application runtime.
# Local example (PostgreSQL running on localhost):
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@127.0.0.1:5432/lmere?sslmode=disable"

# Required for signed admin sessions. Use a unique random value of at least 32 bytes.
ADMIN_SESSION_SECRET="replace-with-a-unique-random-value-at-least-32-bytes"
